{
  "manifest_version": 3,
  "name": "time rings",
  "description": "Extension pomodoro clock",
  "version": "1.0",

  "icons": {
    "48": "icons/work.png",
    "96": "icons/coffee.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Time Rings",
    "default_icon": {
      "48": "icons/work.png",
      "96": "icons/coffee.png"
    }
  },

  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Configuración Time Rings",
    "default_icon": "icons/coffee.png"
  },

  "permissions": ["storage"]
}
